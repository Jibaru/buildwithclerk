# Clerk — https://dashboard.clerk.com → your application → API keys
# No account yet? `npx clerk@latest init --accountless` writes temporary dev keys to .env.local.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where Clerk sends people. Our sign-in is a custom UI built with Clerk Elements.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Public URL of this deployment, used for canonical links and the sitemap.
SITE_URL=http://localhost:3000

# Signs the anonymous-progress cookie before an account exists. Any long random string.
BWC_COOKIE_SECRET=change-me
